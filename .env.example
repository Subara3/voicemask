# このファイルを .env にコピーして値を入れる（.env は git に入れない）

# AmiVoice API（マイページの接続情報にある APPKEY）
AMIVOICE_API_KEY=

# Google Cloud Text-to-Speech（APIキー）
GOOGLE_TTS_API_KEY=

# Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# Claude（eval --llm と run --summarize で使う。使った金額は data/llm/ledger.json、上限は既定10ドル）
ANTHROPIC_API_KEY=
# VOICEMASK_LLM_BUDGET_USD=10

# 監査ログのハッシュの鍵（未設定なら実行ごとに使い捨ての鍵）
# VOICEMASK_AUDIT_KEY=
